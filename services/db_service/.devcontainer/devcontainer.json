{
  "name": "Climora DB Service",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "workspaceFolder": "/workspaces/db_service",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/db_service,type=bind",
  "containerEnv": {
    "PYTHONPATH": "/workspaces/db_service"
  },
  "forwardPorts": [8002],
  "postCreateCommand": "pip install --no-cache-dir -r requirements.txt",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.testing.pytestEnabled": false
      },
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "ms-python.vscode-pylance"
      ]
    }
  }
}
